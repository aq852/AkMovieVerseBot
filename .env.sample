# Telegram API Credentials (Get from https://my.telegram.org)
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=YourAutoFilterBot

# MongoDB Credentials (Get from https://www.mongodb.com/cloud/atlas)
DATABASE_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=AutoFilterBot

# Admins and Channel IDs (separated by spaces)
ADMINS=123456789 987654321
CHANNELS=-1001234567890 -1009876543210
LOG_CHANNEL=-1001122334455

# Multi-channel Force Subscribe (Usernames or Channel IDs separated by space)
FORCE_SUB_CHANNELS=@MyUpdatesChannel -1001998877665
AUTO_APPROVE=True

# Monetization & URL Shortener
SHORTENER_ENABLED=True
SHORTENER_URL=shareus.io
SHORTENER_API=your_shortener_api_key_here
VERIFY_EXPIRE=86400
TUTORIAL_URL=https://t.me/YourTutorialLink

# UI & Customization
ENABLE_IMDB=True
SINGLE_BUTTON=True
AUTO_DELETE_TIME=300
PROTECT_CONTENT=False
PORT=8080
ALLOW_CLONE=True

# Universal Downloader & Silent Dump Settings
DOWNLOADER_ACCESS=public
DUMP_CHANNEL=-1001122334455
DOWNLOADER_MAX_SIZE=100
DOWNLOADER_COOLDOWN=30
COOKIES_FILE=cookies.txt

